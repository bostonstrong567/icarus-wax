<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Wax Setup</AssemblyName>
    <RootNamespace>WaxSetup</RootNamespace>
    <StartupObject>WaxSetup.Program</StartupObject>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <Optimize Condition="'$(Configuration)' != 'Debug'">true</Optimize>
    <Deterministic>true</Deterministic>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <WaxVersion Condition="'$(WaxVersion)' == ''">0.0.0</WaxVersion>
    <Version>$(WaxVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Wax Setup</AssemblyTitle>
    <Product>Wax for ICARUS</Product>
    <Company>Wax</Company>
    <Description>Installs Wax into ICARUS</Description>
    <Copyright></Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- The files to install, packed by scripts\Build-WaxSetup.ps1. Without them the program builds but installs nothing. -->
  <ItemGroup Condition="'$(PayloadFolder)' != ''">
    <EmbeddedResource Include="$(PayloadFolder)\payload.bin" LogicalName="payload.bin" />
    <EmbeddedResource Include="$(PayloadFolder)\payload.list" LogicalName="payload.list" />
  </ItemGroup>

</Project>
