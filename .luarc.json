{
    "runtime.version": "Lua 5.4",
    "runtime.builtin": {
        "basic": "disable"
    },
    "runtime.plugin": "wax/lsp/plugin.lua",
    "workspace.library": [
        "wax/types"
    ],
    "workspace.ignoreDir": [
        ".vscode",
        "/build",
